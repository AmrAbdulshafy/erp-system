{
  "name": "jin-engine-erp",
  "version": "1.0.0",
  "description": "Jin Engine ERP System — Created by Jinnworx, Developed by Amr Abdulshafy",
  "author": "Jinnworx — Developed by Amr Abdulshafy",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "node electron/copy-standalone.js && node electron/launch.js",
    "electron": "node electron/copy-standalone.js && electron .",
    "electron:dev": "node electron/launch.js",
    "dist:prepare": "next build && node electron/copy-standalone.js",
    "dist:win": "pnpm dist:prepare && electron-builder --win nsis",
    "dist": "pnpm dist:win"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "i18next": "^26.5.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.1.3",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.jinnworx.jinengine",
    "productName": "Jin Engine",
    "copyright": "Copyright © 2026 Jinnworx — Developed by Amr Abdulshafy",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/jinnworx-logo-dark.png",
      "public/jinnworx-logo-light.png",
      "public/jinnworx-logo-512.png",
      ".next/standalone/**/*"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Jin Engine ERP System - Created by Jinnworx, Developed by Amr Abdulshafy",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jin Engine",
      "menuCategory": "Jinnworx",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallDisplayName": "Jin Engine ERP System - Jinnworx (Developed by Amr Abdulshafy)",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Jin-Engine-Setup-${version}.${ext}"
    }
  }
}
